# Postgres connection string. Local default matches docker-compose.yml.
DATABASE_URL=postgres://kvk:kvk@localhost:5432/kvk
# Password for the admin page (/admin). Required.
ADMIN_PASSWORD=change-me
# Long random text used to sign the admin login cookie
SECRET_KEY=generate-a-long-random-string
# Optional: MightPulse API key to fill in player names from the game ID
MIGHTPULSE_API_KEY=
